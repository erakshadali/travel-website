# Copy to .env and fill in. Never commit .env.
# On Render, set these under Environment instead of using a file.

NODE_ENV=development
PORT=4111

# MongoDB Atlas (free M0) -> Connect -> Drivers -> copy the connection string.
# Put the database name after ".net/" (here: fatima-tours) and replace <db_password> with the
# database user's password (URL-encode special characters such as @ : / ? # %).
MONGODB_URI=mongodb+srv://USER:<db_password>@cluster0.xxxxx.mongodb.net/fatima-tours?appName=fatima-tours

# Signs admin tokens. 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Single admin account. Generate the hash with:  npm run hash-password
# Keep the single quotes: a bcrypt hash contains "$" characters.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=''

# Browsers allowed to call the API (comma separated, no trailing slashes).
FRONTEND_ORIGINS=http://localhost:5180,https://premium-travels-one.vercel.app

# Max submissions per visitor (IP) per hour, counted separately for each public form. Optional.
# PUBLIC_RATE_LIMIT_PER_HOUR=10

# ---- Notifications (email + WhatsApp). Full setup guide: NOTIFICATIONS.md ----------------------
# log  = nothing is sent; messages are printed and recorded (the default)
# live = really send; needs the keys below
NOTIFY_MODE=log
# Where "new booking" alerts go
AGENCY_EMAIL=you@example.com
# onboarding@resend.dev needs no domain but only delivers to the email your Resend account was created with
EMAIL_FROM="Premium Tours and Travels <onboarding@resend.dev>"
# Used only by `npm run notify:check`
NOTIFY_TEST_EMAIL=you@example.com
NOTIFY_TEST_WHATSAPP=+911234567890
# Adds an "Open in admin" button to the agency alert (the deployed site's address)
# SITE_URL=https://your-site.vercel.app
# Optional: WHATSAPP_API_VERSION=v23.0   WHATSAPP_TEMPLATE_LANGUAGE=en

# Keys (empty = not set)
RESEND_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
