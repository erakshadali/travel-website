# Copy to .env (or .env.local) to send form submissions to the backend.
# Include the /api suffix. Leave this out to run with simulated submissions (no backend needed).
# For the live site, set the same variable in Vercel (Project > Settings > Environment Variables)
# to the Render URL, then redeploy: Vite bakes it in at build time.
VITE_API_URL=http://localhost:4111/api
